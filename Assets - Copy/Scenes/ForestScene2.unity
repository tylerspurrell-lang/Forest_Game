  m_Script: {fileID: 11500000, guid: 6dd68ea668da14b49a0d785b889d6944, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  description: 
  finalChoice: 0
  storyManager: {fileID: 1234620263}
  isClue: 1
  clueText: "**RESEARCH REPORT \u2014 RESTRICTED**\r\nExperiment 07: Unknown Signal,
    The signal appears to respond to human speech. Recordings reveal that it can
    reproduce the voices of personnel who have never transmitted on this frequency.\r\n\r\nAt
    02:13 AM, the receiver broadcast the voice of a researcher who had been missing
    for six days.\r\n\r\nThe voice repeatedly asked us to open the station doors.\r\n\r\nWe
    disconnected the receiver, but the voice continued. The final words recorded
    were:\r\n\r\n\"Why did you leave me out here?\"\r\n\r\nAll further experiments
    are suspended until the source of the signal can be identified."
  interactionSound: {fileID: 0}
  backgroundStatic: {fileID: 0}
  stopStaticOnInteract: 0
