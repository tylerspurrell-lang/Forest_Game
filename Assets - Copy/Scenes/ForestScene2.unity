  m_Script: {fileID: 11500000, guid: 6dd68ea668da14b49a0d785b889d6944, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  description: 
  finalChoice: 0
  storyManager: {fileID: 0}
  isClue: 1
  clueText: "**EMERGENCY LOG \u2014 TRANSMISSION FAILURE**\r\n\r\n03:06 AM \u2014
    The tower transmitter was shut down. Power was cut, and the antenna was disconnected.\r\n\r\n03:07
    AM \u2014 The signal returned.\r\nThe transmission was no longer coming from
    the tower. Every receiver in the station picked it up, including equipment with
    no power source.\r\n\r\nThen we heard our own voices coming through the speakers.
    Every member of the team was speaking at once.\r\n\r\nOne voice was different.\r\nIt
    belonged to someone who hadn't arrived yet.\r\n\r\nThe recording ends with a
    final warning:\r\n\r\n\"Do not activate the main radio. It is waiting for someone
    to answer.\""
  interactionSound: {fileID: 0}
  backgroundStatic: {fileID: 0}
  stopStaticOnInteract: 0
