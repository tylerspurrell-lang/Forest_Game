  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "**PERSONAL NOTE \u2014 11:47 PM**\r\n\r\nI heard someone calling my\n
    name through the radio tonight.\r\n\r\nAt first, I thought it was \none of the
    other researchers.\n But the voice knew things\n I had never told anyone.\r\n\r\nThen
    it told me to look behind me.\r\n\r\nNobody was there.\r\n\r\nWhen I turned back
    to the radio,\n the voice whispered:\r\n\r\n\"You looked anyway.\"\r\n\r\nI haven't
    told the others.\n I don't think I want to know how it knew."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
