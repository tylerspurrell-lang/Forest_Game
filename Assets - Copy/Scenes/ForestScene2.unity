  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "**RESEARCH REPORT \u2014 RESTRICTED**\r\n\r\nExperiment 07: Unknown Signal\r\n\r\nThe
    signal appears to\n respond to human speech. Recordings\n reveal that it can\n
    reproduce the voices of personnel \nwho have never transmitted \non this frequency.\r\n\r\nAt
    02:13 AM, the receiver\n broadcast the voice of a\n researcher who had been missing
    for six days.\r\n\r\nThe voice repeatedly \nasked us to open the station doors.\r\n\r\nWe
    disconnected the receiver, but the voice continued.\r\n\r\nThe final words recorded
    were:\r\n\r\n\"Why did you leave me out here?\"\r\n\r\nAll further experiments\n
    are suspended until the\n source of the signal can be identified."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
