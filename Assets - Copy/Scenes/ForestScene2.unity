  m_Name: 
  m_EditorClassIdentifier: 
  description: 
  finalChoice: 0
  storyManager: {fileID: 1234620263}
  isClue: 1
  clueText: "**PERSONAL NOTE \u2014 11:47 PM**\r\n\r\nI heard someone calling my
    name through the radio tonight. At first, I thought it was one of the other researchers.
    But the voice knew things I had never told anyone.\r\n\r\nThen it told me to
    look behind me.\r\n\r\nNobody was there.\r\n\r\nWhen I turned back to the radio,
    the voice whispered:\r\n\r\n\"You looked anyway.\"\r\n\r\nI haven't told the
    others. I don't think I want to know how it knew."
  interactionSound: {fileID: 0}
  backgroundStatic: {fileID: 0}
  stopStaticOnInteract: 0
